  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.12, g: 0.16, b: 0.22, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 76ccb35c73391da4d98de49c9f927033, type: 3}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Halo teman-teman TK 'Aisyiyah 28!\nIngat 4 langkah pahlawan cilik saat
    gempa:\n\n1. TANGGAP GEMPA\n   Saat alarm berbunyi atau bumi bergetar, jangan
    panik dan tetap tenang!\n\n2. DROP & COVER (RUNDUK & LINDUNGI DIRI)\n   Segera
    lari ke kolong meja terdekat, lalu tekan tombol RUNDUK.\n   Tahan sampai guncangan
    gempa bumi berhenti.\n\n3. LINDUNGI KEPALA DENGAN TAS SEKOLAH\n   Pegang tas
    atau benda empuk di atas kepala untuk menghindari runtuhan.\n\n4. EVAKUASI TERTIB
    KE TITIK KUMPUL\n   Ikuti garis jalur evakuasi hijau menuju lapangan terbuka
    bersama Bu Guru!"
